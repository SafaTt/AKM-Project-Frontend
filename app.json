{
  "expo": {
    "name": "AKM-App",
    "slug": "AKM-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/generals/logo.png",
    "scheme": "akmapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "navigationBar": {
        "visible": true,
        "barStyle": "light-content",
        "backgroundColor": "transparent"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/generals/logo.png",
        "backgroundColor": "#ffffff"
      },

      "edgeToEdge": true,
      "package": "com.safatouil.AKMApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7e19e58-96c1-4ad3-8c9a-61aaa47e1a7d"
      }
    }
  }
}
